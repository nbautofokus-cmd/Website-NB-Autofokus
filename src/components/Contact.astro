---
import '../styles/contact.css';
---
<section class="contact section section--coal" id="kontakt" aria-label="Kontakt">
  <div class="container contact__inner">
    <header class="contact__header reveal">
      <span class="section-label">Kontakt</span>
      <h2 class="h-section">Lass uns<br/>dein Auto<br/>in Szene setzen.</h2>
      <p class="contact__lead">
        Schick mir dein Auto, deine Idee und einen Wunschzeitraum — ich melde
        mich meist innerhalb von 24 Stunden mit einem Vorschlag zurück.
      </p>
    </header>

    <div class="contact__cards">
      <a class="contact-card reveal" href="mailto:info@nb-autofokus.de">
        <span class="contact-card__label">E-Mail</span>
        <span class="contact-card__value">info@nb-autofokus.de</span>
        <span class="contact-card__arrow" aria-hidden="true">→</span>
      </a>
      <a class="contact-card reveal reveal--delay-1" href="https://instagram.com/nb_autofokus" target="_blank" rel="noopener noreferrer">
        <span class="contact-card__label">Instagram</span>
        <span class="contact-card__value">@nb.autofokus</span>
        <span class="contact-card__arrow" aria-hidden="true">→</span>
      </a>
      <div class="contact-card contact-card--static reveal reveal--delay-2">
        <span class="contact-card__label">Region</span>
        <span class="contact-card__value">Rhein-Main Gebiet</span>
      </div>
    </div>
  </div>
</section>
