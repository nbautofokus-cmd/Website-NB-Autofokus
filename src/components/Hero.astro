---
import '../styles/hero.css';

const slides = [
  {
    image: '/images/hero/hero-1-desktop.jpg',
    imageMobile: '/images/hero/hero-1-mobile.jpg',
    alt: 'Autofotograf Rhein-Main – NB Autofokus',
    eyebrow: 'Autofotograf · Rhein-Main',
    title: 'Dein Auto.\nDein Moment.',
    sub: 'Professionelle Autofotografie im Rhein-Main-Gebiet',
  },
  {
    image: '/images/hero/hero-2-desktop.jpg',
    imageMobile: '/images/hero/hero-2-mobile.jpg',
    alt: 'Static Shoot — Sportwagen in Industriearchitektur',
    eyebrow: 'Oldtimer Fotografie',
    title: 'Stillstand mit\nWirkung.',
    sub: 'Details und Komposition',
  },
  {
    image: '/images/hero/hero-3-desktop.jpg',
    imageMobile: '/images/hero/hero-3-mobile.jpg',
    alt: 'Akkreditierter Pressefotograf im Blaulichtbereich – NB Autofokus',
    eyebrow: 'Pressefotografie · Blaulicht',
    title: 'Mittendrin.',
    sub: 'Als Pressefotograf im Einsatz',
  },
];
---
<section class="hero" id="start" aria-label="Startbereich">
  {slides.map((slide, i) => (
    <div class={`hero__slide${i === 0 ? ' is-active' : ''}`} data-index={i}>
      <div class="hero__image-wrap">
        <picture>
          <source media="(max-width: 768px)" srcset={slide.imageMobile} />
          <img
            src={slide.image}
            alt={slide.alt}
            width="1920"
            height="1080"
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : 'auto'}
          />
        </picture>
        <div class="hero__vignette" aria-hidden="true"></div>
      </div>
      <div class="hero__content container">
        <span class="hero__eyebrow">{slide.eyebrow}</span>
        <h1 class="hero__title h-display" set:html={slide.title.replace(/\n/g, '<br/>')}></h1>
        <p class="hero__sub">{slide.sub}</p>
      </div>
    </div>
  ))}

  <div class="hero__meta">
    <div class="hero__counter">
      <span class="hero__counter-current" data-counter="current">01</span>
      <span class="hero__counter-divider">/</span>
      <span class="hero__counter-total">{String(slides.length).padStart(2, '0')}</span>
    </div>
    <div class="hero__dots" role="tablist" aria-label="Slideshow Navigation">
      {slides.map((_, i) => (
        <button
          class={`hero__dot${i === 0 ? ' is-active' : ''}`}
          role="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-label={`Slide ${i + 1}`}
          data-dot={i}
        />
      ))}
    </div>
  </div>

  <div class="hero__scroll" aria-hidden="true">
    <span class="hero__scroll-label">Scroll</span>
    <div class="hero__scroll-line"></div>
  </div>
</section>

<script>
  const DURATION = 6500;
  const slides = Array.from(document.querySelectorAll<HTMLElement>('.hero__slide'));
  const dots   = Array.from(document.querySelectorAll<HTMLButtonElement>('.hero__dot'));
  const counter = document.querySelector<HTMLElement>('[data-counter="current"]');
  let current  = 0;
  let timer: ReturnType<typeof setInterval>;

  function goTo(next: number) {
    slides[current].classList.remove('is-active');
    dots[current]?.classList.remove('is-active');
    dots[current]?.setAttribute('aria-selected', 'false');
    current = next;
    slides[current].classList.add('is-active');
    dots[current]?.classList.add('is-active');
    dots[current]?.setAttribute('aria-selected', 'true');
    if (counter) counter.textContent = String(current + 1).padStart(2, '0');
  }

  function advance() { goTo((current + 1) % slides.length); }
  function start()   { timer = setInterval(advance, DURATION); }
  function reset()   { clearInterval(timer); start(); }

  dots.forEach((dot, i) => {
    dot.addEventListener('click', () => { goTo(i); reset(); });
  });

  start();

</script>
