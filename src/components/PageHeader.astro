---
interface Props {
  label: string;
  title: string;
  sub?: string;
  image?: string;
}
const { label, title, sub, image } = Astro.props;
const webp = image ? image.replace(/\.jpg$/, '.webp') : null;
---
<header class={`page-header${image ? ' page-header--img' : ''}`}>
  {image && (
    <div class="page-header__bg">
      <picture>
        {webp && <source srcset={webp} type="image/webp" />}
        <img src={image} alt="" role="presentation" loading="eager" decoding="async" />
      </picture>
      <div class="page-header__overlay"></div>
    </div>
  )}
  <div class="container page-header__inner">
    <span class="section-label">{label}</span>
    <h1 class="page-header__title h-display" set:html={title}></h1>
    {sub && <p class="page-header__sub">{sub}</p>}
  </div>
</header>

<style>
.page-header {
  padding-top: calc(80px + var(--space-16));
  padding-bottom: var(--space-12);
  background: var(--color-coal);
  border-bottom: 1px solid var(--color-iron);
  position: relative;
  overflow: hidden;
}

.page-header::before {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse 60% 80% at 50% 120%, rgba(230,57,70,0.06) 0%, transparent 70%);
  pointer-events: none;
}

.page-header--img {
  min-height: 62vh;
  padding-top: 0;
  padding-bottom: 0;
  border-bottom: none;
  display: flex;
  align-items: flex-end;
}

.page-header--img::before { display: none; }

.page-header--img .page-header__inner {
  padding-top: calc(80px + var(--space-12));
  padding-bottom: clamp(var(--space-12), 6vh, var(--space-24));
  width: 100%;
}

.page-header__bg {
  position: absolute;
  inset: 0;
  overflow: hidden;
}

.page-header__bg img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  filter: contrast(1.05) saturate(0.85);
  transform: scale(1.06);
  animation: phZoom 12s ease-out forwards;
}

@keyframes phZoom {
  from { transform: scale(1.08); }
  to   { transform: scale(1.00); }
}

@media (prefers-reduced-motion: reduce) {
  .page-header__bg img { animation: none; transform: scale(1); }
}

.page-header__overlay {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(rgba(10,10,10,0.25), rgba(10,10,10,0.25)),
    linear-gradient(to bottom,
      rgba(10,10,10,0.45) 0%,
      rgba(10,10,10,0.2)  40%,
      rgba(10,10,10,0.7)  75%,
      rgba(10,10,10,0.92) 100%),
    radial-gradient(ellipse at center, transparent 50%, rgba(10,10,10,0.4) 100%);
}

.page-header__inner {
  position: relative;
}

.page-header__title {
  font-size: clamp(4rem, 10vw, 10rem);
  line-height: 0.9;
  color: var(--color-white);
  margin-top: var(--space-4);
}

.page-header__sub {
  margin-top: var(--space-6);
  font-size: 1.1rem;
  color: var(--color-silver);
  max-width: 52ch;
  line-height: 1.65;
}
</style>
