---
import '../styles/prices.css';

interface Props {
  /** Nur einen Bereich zeigen — sonst beide. */
  only?: 'auto' | 'event';
  /** Anfrage-Button unter dem Block ausblenden, wenn die Seite schon einen hat. */
  cta?: boolean;
}

const { only, cta = true } = Astro.props;
const showAuto = only !== 'event';
const showEvent = only !== 'auto';

const packages = [
  {
    id: 'S',
    price: '50',
    photos: 5,
    lieferzeit: '3 Tagen',
    featured: false,
  },
  {
    id: 'M',
    price: '70',
    photos: 10,
    lieferzeit: '5 Tagen',
    featured: false,
  },
  {
    id: 'L',
    price: '100',
    photos: 20,
    lieferzeit: '7 Tagen',
    note: 'Ideal für den Autoverkauf',
    featured: true,
  },
];

const included = [
  'Anfahrtskosten (Rodgau + 20 km inklusive)',
  'Professionelle Bildbearbeitung',
];

const eventPackages = [
  { id: 'Basic',   price: '100', note: 'Für kleine Veranstaltungen und kurze Einsätze', dauer: '1 Stunde',  photos: 30,  featured: false },
  { id: 'Classic', price: '200', note: 'Für größere Veranstaltungen',                   dauer: '2 Stunden', photos: 60,  featured: true },
  { id: 'Premium', price: '350', note: 'Für umfangreiche Events',                       dauer: '4 Stunden', photos: 100, featured: false },
];

const eventIncluded = [
  'Lieferung innerhalb von 7 Werktagen',
  'Digitale Bereitstellung in hoher Auflösung',
  'Anfahrt (Rodgau + 50 km) inklusive',
];

const addons = [
  { name: 'Weitere digitale Bilder', price: '5 € / Bild' },
  { name: 'Polaroid-Prints', price: '5 € / Bild' },
  { name: 'Lieferung am nächsten Tag', price: '+20 % Aufpreis' },
  { name: 'Drohnenaufnahmen', price: 'auf Anfrage' },
  { name: 'Videos & Reels', price: 'auf Anfrage' },
];
---

<section class="prices section section--coal" id="preise" aria-label="Infos und Preise">
  <div class="container">

    {only && (
    <header class="prices__header">
      <span class="section-label reveal">Preise</span>
      <h2 class="h-section reveal" set:html={only === 'auto' ? 'Pakete &amp;<br/>Preise.' : 'Was kostet<br/>es?'} />
    </header>
    )}

    <!-- ─── Autofotografie ─────────────────────────── -->
    {showAuto && (
    <div class="prices__block">
      {!only && <div class="prices__category-divider reveal">Autofotografie</div>}

      <div class="price-grid reveal">
        {packages.map((pkg) => (
          <article class:list={['price-card', pkg.featured && 'price-card--featured']}>
            <div class="price-card__head">
              <span class="price-card__title">
                <span class="price-card__id">Paket {pkg.id}</span>
                {pkg.note && <span class="price-card__aside">{pkg.note}</span>}
              </span>
            </div>
            <div class="price-card__price">
              <div class="price-card__amount">{pkg.price} €</div>
              {pkg.featured && <span class="price-card__tag">meistgewählt</span>}
            </div>
            <ul class="price-card__details">
              <li>{pkg.photos} bearbeitete Fotos</li>
              <li>Digitale Lieferung innerhalb von {pkg.lieferzeit}</li>
              {included.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        ))}
      </div>

      <div class="prices__bottom reveal">
        <div class="prices__addons">
          <p class="prices__sub-label">Optionale Extras</p>
          <div class="prices__addons-list">
            {addons.map((addon) => (
              <div class="prices__addon">
                <span class="prices__addon-name">{addon.name}</span>
                <span class="prices__addon-price">{addon.price}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      {cta && (
      <div class="prices__cta-center reveal">
        <a href="/kontakt" class="btn btn--primary">
          Autoshooting anfragen
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="3" y1="8" x2="13" y2="8"/>
            <polyline points="9,4 13,8 9,12"/>
          </svg>
        </a>
      </div>
      )}
    </div>
    )}

    <!-- ─── Eventfotografie ────────────────────────── -->
    {showEvent && (
    <div class:list={['prices__block', showAuto && 'prices__block--event']}>
      {!only && <div class="prices__category-divider reveal">Eventfotografie</div>}

      <div class="price-grid reveal">
        {eventPackages.map((pkg) => (
          <article class:list={['price-card', pkg.featured && 'price-card--featured']}>
            <div class="price-card__head">
              <span class="price-card__id">Event {pkg.id}</span>
            </div>
            <div class="price-card__price">
              <div class="price-card__amount">{pkg.price} €</div>
              {pkg.featured && <span class="price-card__tag">meistgewählt</span>}
            </div>
            <p class="price-card__note">{pkg.note}</p>
            <ul class="price-card__details">
              <li>Bis zu {pkg.dauer} fotografische Begleitung</li>
              <li>Mindestens {pkg.photos} bearbeitete Bilder</li>
              {eventIncluded.map((item) => <li>{item}</li>)}
            </ul>
            <p class="price-card__hint">Optional: Bilderlieferung während des Events (+ 50 €)</p>
          </article>
        ))}
      </div>

      <div class="prices__bottom reveal">
        <div class="prices__addons">
          <p class="prices__sub-label">Optionale Extras</p>
          <div class="prices__addons-list">
            <div class="prices__addon">
              <div>
                <span class="prices__addon-name">Bilderlieferung während des Events</span>
                <p class="prices__addon-desc">
                  5–10 bearbeitete Bilder noch während der Veranstaltung.
                </p>
              </div>
              <span class="prices__addon-price">+ 50 €</span>
            </div>
            <div class="prices__addon">
              <span class="prices__addon-name">Längere Events (über 4 Stunden)</span>
              <span class="prices__addon-price">auf Anfrage</span>
            </div>
            <div class="prices__addon">
              <span class="prices__addon-name">Drohnenaufnahmen</span>
              <span class="prices__addon-price">auf Anfrage</span>
            </div>
            <div class="prices__addon">
              <span class="prices__addon-name">Videos & Reels</span>
              <span class="prices__addon-price">auf Anfrage</span>
            </div>
          </div>
        </div>
      </div>

      {cta && (
      <div class="prices__cta-center reveal">
        <a href="/kontakt" class="btn btn--primary">
          Eventbegleitung anfragen
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="3" y1="8" x2="13" y2="8"/>
            <polyline points="9,4 13,8 9,12"/>
          </svg>
        </a>
      </div>
      )}
    </div>
    )}

  </div>
</section>
