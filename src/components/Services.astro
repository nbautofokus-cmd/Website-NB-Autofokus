---
import '../styles/services.css';

const services = [
  {
    no: '01',
    title: 'Static Shots',
    desc: 'Dein Auto in Szene gesetzt — ideal für Social Media oder als Deko für daheim.',
    bullets: ['Location-Auswahl', 'Bis zu 60 Min. vor Ort', '5–20 finale Bilder'],
  },
  {
    no: '02',
    title: 'Rolling Shots',
    desc: 'Bewegungsaufnahmen mit Mitzieh-Effekt. Begleitfahrzeug und Fahrer müssen gestellt werden.',
    bullets: ['Dynamische Aufnahmen während der Fahrt', 'Action-Edit inklusive', 'Drohnenaufnahmen möglich'],
  },
  {
    no: '03',
    title: 'Verkaufsfotos',
    desc: 'Du möchtest dein Auto verkaufen? Professionelle Fotos heben dein Inserat aus der Masse — mehr Vertrauen, mehr Klicks, schnellerer Verkauf.',
    bullets: ['Außen- & Innenaufnahmen', 'Detailshots auf Wunsch', 'Schnelle Lieferung'],
  },
  {
    no: '04',
    title: 'Events & Treffen',
    desc: 'Reportage von Carmeets, Cars & Coffee oder Clubevents. Authentisch dokumentiert, schnell ausgeliefert.',
    bullets: ['Reportagestil', 'Schnelle Lieferung nach dem Event', 'Pakete ab 2 Std.'],
  },
];
---
<section class="services section section--coal" id="leistungen" aria-label="Leistungen">
  <div class="container">
    <header class="services__header">
      <span class="section-label reveal">Leistungen</span>
      <h2 class="h-section reveal">Was ich anbiete.</h2>
    </header>

    <div class="services__grid">
      {services.map((s, i) => (
        <article class={`service-card reveal reveal--delay-${(i % 3) + 1}`}>
          <span class="service-card__no">{s.no}</span>
          <h3 class="service-card__title">{s.title}</h3>
          <p class="service-card__desc">{s.desc}</p>
          <ul class="service-card__list">
            {s.bullets.map((b) => (
              <li>
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="3,8 7,12 13,4"/>
                </svg>
                <span>{b}</span>
              </li>
            ))}
          </ul>
          <a href="#kontakt" class="service-card__link">
            Anfragen
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="3" y1="8" x2="13" y2="8"/>
              <polyline points="9,4 13,8 9,12"/>
            </svg>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
