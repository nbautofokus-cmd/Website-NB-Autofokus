---
interface Props {
  steps: { title: string; desc: string }[];
  label?: string;
  title?: string;
}

const { steps, label = 'Was dich erwartet', title = 'Der Ablauf.' } = Astro.props;
---
<section class="section">
  <div class="container">
    <header class="section-header reveal">
      <span class="section-label">{label}</span>
      <h2 class="h-section">{title}</h2>
    </header>
    <div class="steps">
      {steps.map((s, i) => (
        <div class={`step reveal reveal--delay-${i + 1}`}>
          <div class="step__marker">
            <span class="step__no">{String(i + 1).padStart(2, '0')}</span>
            {i < steps.length - 1 && <span class="step__line" aria-hidden="true"></span>}
          </div>
          <div class="step__body">
            <h3 class="step__title">{s.title}</h3>
            <p class="step__desc">{s.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
/* Steps */
.section-header { margin-bottom: var(--space-12); }

.steps {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--space-8);
}

.step {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.step__marker {
  display: flex;
  align-items: center;
  gap: var(--space-4);
}

.step__no {
  font-family: var(--font-display);
  font-size: 2.2rem;
  color: var(--color-signal);
  line-height: 1;
  flex-shrink: 0;
}

.step__line {
  flex: 1;
  height: 1px;
  background: var(--color-iron);
}

.step__title {
  font-family: var(--font-display);
  font-size: 1.4rem;
  letter-spacing: 0.04em;
  color: var(--color-white);
  margin-bottom: var(--space-2);
}

.step__desc { font-size: var(--text-caption); color: var(--color-silver); line-height: 1.6; }

@media (max-width: 900px) {
  .steps { grid-template-columns: 1fr 1fr; }
}

@media (max-width: 600px) {
  .steps { grid-template-columns: 1fr; }
  .step__line { display: none; }
}
</style>
