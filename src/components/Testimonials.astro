---
import '../styles/testimonials.css';

const reviews = [
  {
    name: 'Tiziano',
    subject: 'VW Golf 5 GTI',
    text: 'Super sympathisch. Bin mehr als zufrieden mit den Ergebnissen. Fotos sind top, das Shooting hat Spaß gemacht, kann ich nur weiterempfehlen und werde immer wieder kommen.',
    rating: 5,
    source: 'Google',
  },
  {
    name: 'Chris',
    subject: 'Bagged Caddy',
    text: 'Ein sehr professioneller und sympathischer Fotograf. Meine Vorstellungen wurden super umgesetzt und ich hab mich von Anfang bis Ende wohlgefühlt. Die Ergebnisse sind echt Hammer geworden. Jederzeit wieder – Nächstes Shooting',
    rating: 5,
    source: 'Google',
  },
];
---

<section class="testimonials section" id="feedback" aria-label="Kundenfeedback">
  <div class="container">
    <header class="testimonials__header">
      <span class="section-label reveal">Feedback</span>
      <h2 class="h-section reveal">Was Kunden<br/>sagen.</h2>
    </header>

    <div class="testimonials__grid">
      {reviews.map((review, i) => (
        <article class={`review-card reveal reveal--delay-${i + 1}`}>
          <div class="review-card__car">{review.subject}</div>

          <blockquote class="review-card__text">
            <p>„{review.text}"</p>
          </blockquote>

          <footer class="review-card__footer">
            <div class="review-card__stars" aria-label={`${review.rating} von 5 Sternen`}>
              {Array.from({ length: review.rating }).map(() => (
                <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <polygon points="12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26"/>
                </svg>
              ))}
            </div>
            <div class="review-card__meta">
              <span class="review-card__name">{review.name}</span>
              {review.source === 'Google' && (
                <span class="review-card__google" aria-label="Google Bewertung">
                  <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
                    <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                    <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                    <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"/>
                    <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                  </svg>
                  Google
                </span>
              )}
            </div>
          </footer>
        </article>
      ))}
    </div>

  </div>
</section>
