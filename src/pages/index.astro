---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Testimonials from '../components/Testimonials.astro';
import Footer from '../components/Footer.astro';
import { shootings, type Shooting } from '../data/shootings';
import { getImage, Image } from 'astro:assets';
import h1d from '../assets/images/hero/hero-1-desktop.jpg';
import h1m from '../assets/images/hero/hero-1-mobile.jpg';
import portrait from '../assets/images/about/portrait.jpg';

const [preloadD, preloadM] = await Promise.all([
  getImage({ src: h1d, width: 1920, height: 1080, format: 'webp', quality: 65 }),
  getImage({ src: h1m, width: 768, height: 1080, format: 'webp', quality: 65 }),
]);

const featured = [
  shootings.find(s => s.slug === 'autoshooting-1'),
  shootings.find(s => s.slug === 'autoshooting-3'),
  shootings.find(s => s.slug === 'event-4'),
  shootings.find(s => s.slug === 'autoshooting-4'),
].filter((s): s is Shooting => s !== undefined);

const ctaBild = shootings.find(s => s.slug === 'autoshooting-3')!.cover;
---
<BaseLayout>
  <link
    rel="preload"
    as="image"
    imagesrcset={`${preloadM.src} 768w, ${preloadD.src} 1920w`}
    imagesizes="(max-width: 768px) 768px, 1920px"
    fetchpriority="high"
    slot="head"
  />
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Photographer",
        "name": "NB Autofokus",
        "description": "Autofotograf und Eventfotograf aus dem Rhein-Main-Gebiet. Fahrzeugpräsentation, Verkaufsfotos und Eventbegleitung.",
        "url": "https://nb-autofokus.de",
        "email": "info@nb-autofokus.de",
        "telephone": "+4917831300087",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Sudetenstr. 25a",
          "addressLocality": "Rodgau",
          "postalCode": "63110",
          "addressRegion": "Hessen",
          "addressCountry": "DE"
        },
        "areaServed": ["Rhein-Main-Gebiet", "Frankfurt", "Offenbach", "Darmstadt", "Hanau", "Rodgau", "Aschaffenburg"],
        "priceRange": "€€",
        "image": "https://nb-autofokus.de/og-image.jpg",
        "sameAs": [
          "https://www.instagram.com/nb_autofokus",
          "https://share.google/nwFARYgEK3yo5vqTL"
        ]
      },
      {
        "@type": "Person",
        "name": "Nicolai Biehl",
        "jobTitle": "Autofotograf und Eventfotograf",
        "url": "https://nb-autofokus.de",
        "email": "info@nb-autofokus.de"
      }
    ]
  })}></script>

  <Nav />
  <main id="main">

    <!-- ─── Hero ──────────────────────────────────────────── -->
    <Hero />

    <!-- ─── Über mich ───────────────────────────────────────── -->
    <section class="section lp-about">
      <div class="container lp-about__layout">
        <div class="lp-about__portrait reveal">
          <Image src={portrait} alt="Nicolai Biehl — NB Autofokus" width={700} height={900} loading="eager" format="webp" quality={82} />
        </div>
        <div class="lp-about__text reveal reveal--delay-1">
          <span class="section-label">Dein Fotograf</span>
          <h2 class="h-section">Nicolai Biehl.</h2>
          <p class="lp-about__lead">Ich bin Fotograf im Rhein-Main-Gebiet — spezialisiert auf Autofotografie und Eventbegleitung. Neben privaten Shootings bin ich regelmäßig für die Firma Kickdown im Einsatz und arbeite außerdem als Pressefotograf für die Agentur 5VISION.</p>
          <div class="lp-about__cta">
            <a href="/infos/ueber-mich" class="btn">Mehr über mich</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ─── Services ──────────────────────────────────────── -->
    <section class="section lp-services">
      <div class="container">
        <div class="lp-services__header reveal">
          <span class="section-label">Was ich anbiete</span>
          <h2 class="h-section lp-services__title">Auto<br/>&amp; Event.</h2>
        </div>
        <div class="lp-services__list">
          <a href="/leistungen/autofotografie" class="lp-service-row reveal">
            <span class="lp-service-row__no">01</span>
            <div class="lp-service-row__body">
              <h3 class="lp-service-row__title">Auto&shy;fotografie</h3>
              <p class="lp-service-row__desc">Für dich privat oder den Verkauf deines Autos.</p>
            </div>
            <svg class="lp-service-row__arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="3" y1="8" x2="13" y2="8"/><polyline points="9,4 13,8 9,12"/>
            </svg>
          </a>
          <a href="/leistungen/eventbegleitung" class="lp-service-row reveal reveal--delay-1">
            <span class="lp-service-row__no">02</span>
            <div class="lp-service-row__body">
              <h3 class="lp-service-row__title">Event&shy;fotografie</h3>
              <p class="lp-service-row__desc">Automotive Events, Firmenfeiern und Clubevents — im Reportagestil, nah dran aber unauffällig.</p>
            </div>
            <svg class="lp-service-row__arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="3" y1="8" x2="13" y2="8"/><polyline points="9,4 13,8 9,12"/>
            </svg>
          </a>
          <a href="/kontakt" class="lp-service-row reveal reveal--delay-2">
            <span class="lp-service-row__no">03</span>
            <div class="lp-service-row__body">
              <h3 class="lp-service-row__title">Dein individuelles Projekt</h3>
              <p class="lp-service-row__desc">Individuelle Anfragen willkommen — schreib mir einfach deine Idee.</p>
            </div>
            <svg class="lp-service-row__arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="3" y1="8" x2="13" y2="8"/><polyline points="9,4 13,8 9,12"/>
            </svg>
          </a>
          <a href="/infos/preise" class="lp-services__price-link">Preise &amp; Pakete ansehen →</a>
        </div>
      </div>
    </section>

    <!-- ─── Featured Work ─────────────────────────────────── -->
    <section class="section lp-work">
      <div class="container">
        <div class="lp-work__header reveal">
          <h2 class="h-section">Ausgewählte<br/>Arbeiten.</h2>
          <a href="/galerie" class="lp-work__all">Zur Galerie →</a>
        </div>
      </div>

      <div class="lp-work__grid">
        {featured.map((s, i) => (
          <a
            href={`/galerie/${s.slug}`}
            class={`lp-work__item lp-work__item--${i} reveal reveal--delay-${(i % 3) + 1}`}
          >
            <div class="lp-work__img">
              <Image src={s.cover} alt={`${s.fahrzeug} – NB Autofokus`} widths={[400, 700, 1000]} sizes="(max-width: 900px) 50vw, 25vw" format="webp" quality={78} loading="lazy" />
              <div class="lp-work__overlay">
                <span class="lp-work__overlay-label">{s.kategorie}</span>
                <span class="lp-work__overlay-title">{s.fahrzeug}</span>
                <span class="lp-work__overlay-cta">{s.gruppe === 'Autoshootings' ? 'Shooting ansehen →' : 'Bilder ansehen →'}</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- ─── Testimonials ──────────────────────────────────── -->
    <Testimonials />

    <!-- ─── CTA ───────────────────────────────────────────── -->
    <section class="lp-cta">
      <div class="lp-cta__bg" aria-hidden="true">
        <Image src={ctaBild} alt="" widths={[640, 1200]} sizes="100vw" format="webp" quality={70} loading="lazy" />
      </div>
      <div class="container lp-cta__inner reveal">
        <h2 class="lp-cta__title">Schreib mir.</h2>
        <p class="lp-cta__sub">Erzähl mir kurz, was du vorhast — Fahrzeug, Termin, Ort. Den Rest klären wir zusammen.</p>
        <div class="lp-cta__actions">
          <a href="/kontakt" class="btn btn--primary lp-cta__btn">
            Anfrage senden
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="3" y1="8" x2="13" y2="8"/><polyline points="9,4 13,8 9,12"/>
            </svg>
          </a>
          <a href="https://instagram.com/nb_autofokus" class="lp-cta__ig" target="_blank" rel="noopener noreferrer">
            Oder schau auf Instagram vorbei →
          </a>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>

<style>
/* ─── Services ──────────────────────────────────────── */
.lp-services { background: var(--color-coal); }

.lp-services__header { margin-bottom: var(--space-12); }

.lp-services__title { max-width: 16ch; }

/* ─── Service list ────────────────────────────────────── */
.lp-services__list {
  display: flex;
  flex-direction: column;
  max-width: 760px;
}

.lp-service-row {
  display: flex;
  align-items: flex-start;
  gap: var(--space-5);
  padding-block: var(--space-6);
  border-bottom: 1px solid var(--color-iron);
  cursor: pointer;
}

.lp-services__list .lp-service-row:first-child { border-top: 1px solid var(--color-iron); }

.lp-service-row__no {
  font-family: var(--font-display);
  font-size: 1.3rem;
  color: var(--color-iron);
  letter-spacing: 0.04em;
  line-height: 1.3;
  transition: color var(--transition-base);
}

.lp-service-row:hover .lp-service-row__no { color: var(--color-signal); }

.lp-service-row__body { flex: 1; }

.lp-service-row__title {
  font-family: var(--font-display);
  font-size: clamp(1.3rem, 2vw, 1.6rem);
  letter-spacing: 0.04em;
  color: var(--color-white);
  margin-bottom: var(--space-2);
}

.lp-service-row__desc {
  font-size: var(--text-caption);
  color: var(--color-silver);
  line-height: 1.6;
  max-width: 40ch;
}

.lp-service-row__arrow {
  color: var(--color-fog);
  flex-shrink: 0;
  margin-top: 0.4rem;
  transition: transform var(--transition-base), color var(--transition-base);
}

.lp-service-row:hover .lp-service-row__arrow {
  color: var(--color-signal);
  transform: translateX(4px);
}

.lp-services__price-link {
  margin-top: var(--space-6);
  font-size: var(--text-label);
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--color-silver);
  transition: color var(--transition-base);
}

.lp-services__price-link:hover { color: var(--color-signal); }

/* ─── Über mich ─────────────────────────────────────── */
.lp-about__layout {
  display: grid;
  grid-template-columns: minmax(240px, 0.8fr) 1fr;
  gap: clamp(2rem, 6vw, 5rem);
  align-items: center;
}

.lp-about__portrait {
  aspect-ratio: 3 / 4;
  overflow: hidden;
  background: var(--color-graphite);
}

.lp-about__portrait img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: contrast(1.05) saturate(0.95);
}

.lp-about__text h2 {
  margin-block: var(--space-3) var(--space-6);
}

.lp-about__lead {
  color: var(--color-silver);
  margin-bottom: var(--space-8);
  line-height: 1.7;
  max-width: 52ch;
}

/* ─── Featured Work ─────────────────────────────────── */
.lp-work { background: var(--color-coal); }

.lp-work__header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: var(--space-6);
  margin-bottom: var(--space-8);
}

.lp-work__all {
  flex-shrink: 0;
  margin-bottom: 0.4rem;
  font-size: var(--text-label);
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--color-silver);
  transition: color var(--transition-base);
}

.lp-work__all:hover { color: var(--color-signal); }

/* Randloses, asymmetrisches Raster */
.lp-work__grid {
  display: grid;
  /* vier gleich große Kacheln in einer Reihe */
  grid-template-columns: repeat(4, 1fr);
  gap: 2px;
  width: 100vw;
  margin-left: calc(50% - 50vw);
}

.lp-work__item {
  position: relative;
  overflow: hidden;
  display: block;
  cursor: pointer;
}

.lp-work__img {
  position: relative;
  width: 100%;
  height: 100%;
  aspect-ratio: 4 / 3;
}

.lp-work__img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 600ms cubic-bezier(0.2, 0.8, 0.2, 1);
}

.lp-work__item:hover .lp-work__img img { transform: scale(1.04); }

.lp-work__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0) 55%);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: var(--space-6);
  opacity: 0;
  transition: opacity var(--transition-base);
}

.lp-work__item:hover .lp-work__overlay { opacity: 1; }

.lp-work__overlay-label {
  font-size: var(--text-label);
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--color-signal);
  margin-bottom: var(--space-1);
}

.lp-work__overlay-title {
  font-family: var(--font-display);
  font-size: 1.6rem;
  letter-spacing: 0.06em;
  color: var(--color-white);
  line-height: 1.1;
  margin-bottom: var(--space-3);
}

.lp-work__overlay-cta {
  font-size: var(--text-caption);
  color: var(--color-silver);
}

/* ─── CTA ───────────────────────────────────────────── */
.lp-cta {
  position: relative;
  padding-block: clamp(5rem, 12vw, 10rem);
  overflow: hidden;
  background: var(--color-black);
  border-top: 1px solid var(--color-iron);
}

.lp-cta__bg {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.lp-cta__bg img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 30%;
  filter: grayscale(0.4) contrast(1.05) brightness(0.55);
  opacity: 0.6;
}

.lp-cta__bg::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, var(--color-black) 0%, rgba(var(--shade), 0.55) 35%, var(--color-black) 100%);
}

.lp-cta__inner {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: var(--space-6);
}

.lp-cta__title {
  font-family: var(--font-display);
  font-size: clamp(4rem, 10vw, 9rem);
  letter-spacing: 0.03em;
  color: var(--color-white);
  line-height: 0.9;
}

.lp-cta__sub {
  color: var(--color-silver);
  max-width: 44ch;
}

.lp-cta__actions {
  display: flex;
  align-items: center;
  gap: var(--space-8);
  flex-wrap: wrap;
  justify-content: center;
  margin-top: var(--space-4);
}

.lp-cta__btn { min-width: 200px; justify-content: center; }

.lp-cta__ig {
  font-size: var(--text-label);
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--color-silver);
  transition: color var(--transition-base);
}

.lp-cta__ig:hover { color: var(--color-signal); }

/* ─── Reduced motion ────────────────────────────────── */
@media (prefers-reduced-motion: reduce) {
  .lp-work__img img { transition: none; }
}

/* ─── Responsive ────────────────────────────────────── */
@media (max-width: 900px) {
  .lp-about__layout { grid-template-columns: 1fr; }
  .lp-about__portrait { max-width: 320px; }

  /* auch am Handy vier Kacheln, als 2×2 */
  .lp-work__grid { grid-template-columns: repeat(2, 1fr); }

  .lp-work__img { aspect-ratio: 1 / 1; }

  .lp-work__overlay { padding: var(--space-3); }
  .lp-work__overlay-title { font-size: 1.15rem; margin-bottom: 0; }
  .lp-work__overlay-label { font-size: 0.65rem; letter-spacing: 0.2em; }
  .lp-work__overlay-cta { display: none; }

  .lp-work__header { flex-direction: column; align-items: flex-start; gap: var(--space-4); }
  .lp-work__all { margin-bottom: 0; }
  .lp-work__overlay { opacity: 1; }
}

@media (max-width: 600px) {
  .lp-cta__actions { flex-direction: column; align-items: center; }
}
</style>
