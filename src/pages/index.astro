---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Gallery from '../components/Gallery.astro';
import Prices from '../components/Prices.astro';
import About from '../components/About.astro';
import Blaulicht from '../components/Blaulicht.astro';
import Testimonials from '../components/Testimonials.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout>
  <script slot="head" type="application/ld+json">{JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Photographer",
        "name": "NB Autofokus",
        "description": "Autofotograf und Eventfotograf aus dem Rhein-Main-Gebiet. Rolling Shots, Static Shots, Eventbegleitung und Pressefotografie im Blaulichtbereich.",
        "url": "https://nb-autofokus.de",
        "email": "info@nb-autofokus.de",
        "telephone": "+4917831300087",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Sudetenstr. 25a",
          "addressLocality": "Rodgau",
          "postalCode": "63110",
          "addressRegion": "Hessen",
          "addressCountry": "DE"
        },
        "areaServed": ["Rhein-Main-Gebiet", "Frankfurt", "Offenbach", "Darmstadt", "Hanau", "Rodgau", "Aschaffenburg"],
        "priceRange": "€€",
        "image": "https://nb-autofokus.de/og-image.jpg",
        "sameAs": [
          "https://www.instagram.com/nb.autofokus",
          "https://share.google/nwFARYgEK3yo5vqTL"
        ]
      },
      {
        "@type": "Person",
        "name": "Nicolai Biehl",
        "jobTitle": "Autofotograf, Eventfotograf und Pressefotograf",
        "url": "https://nb-autofokus.de",
        "email": "info@nb-autofokus.de"
      }
    ]
  })}</script>
  <Nav />
  <main id="main">
    <Hero />
    <About />
    <Services />
    <Prices />
    <Gallery />
    <Blaulicht />
    <Testimonials />
    <Contact />
  </main>
  <Footer />
</BaseLayout>
