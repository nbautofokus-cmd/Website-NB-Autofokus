---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Testimonials from '../components/Testimonials.astro';
import Footer from '../components/Footer.astro';
import { shootings } from '../data/shootings';

const featured = [
  shootings.find(s => s.slug === 'autoshooting-3'),
  shootings.find(s => s.slug === 'event-4'),
  shootings.find(s => s.slug === 'blaulicht-1'),
].filter(Boolean);
---
<BaseLayout>
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Photographer",
        "name": "NB Autofokus",
        "description": "Autofotograf und Eventfotograf aus dem Rhein-Main-Gebiet. Rolling Shots, Static Shots, Eventbegleitung und Pressefotografie im Blaulichtbereich.",
        "url": "https://nb-autofokus.de",
        "email": "info@nb-autofokus.de",
        "telephone": "+4917831300087",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Sudetenstr. 25a",
          "addressLocality": "Rodgau",
          "postalCode": "63110",
          "addressRegion": "Hessen",
          "addressCountry": "DE"
        },
        "areaServed": ["Rhein-Main-Gebiet", "Frankfurt", "Offenbach", "Darmstadt", "Hanau", "Rodgau", "Aschaffenburg"],
        "priceRange": "€€",
        "image": "https://nb-autofokus.de/og-image.jpg",
        "sameAs": [
          "https://www.instagram.com/nb_autofokus",
          "https://share.google/nwFARYgEK3yo5vqTL"
        ]
      },
      {
        "@type": "Person",
        "name": "Nicolai Biehl",
        "jobTitle": "Autofotograf, Eventfotograf und Pressefotograf",
        "url": "https://nb-autofokus.de",
        "email": "info@nb-autofokus.de"
      }
    ]
  })}></script>

  <Nav />
  <main id="main">

    <!-- ─── Hero ──────────────────────────────────────────── -->
    <Hero />

    <!-- ─── Über mich ───────────────────────────────────────── -->
    <section class="section lp-about">
      <div class="container lp-about__inner">
        <div class="lp-about__text reveal">
          <span class="section-label">Dein Fotograf</span>
          <h2 class="h-section">Nicolai Biehl.</h2>
          <p class="lp-about__lead">Ich bin Fotograf im Rhein-Main-Gebiet — spezialisiert auf Autofotografie, Eventbegleitung und Pressefotografie. Neben privaten Shootings bin ich regelmäßig für die Firma Kickdown im Einsatz und als Pressefotograf im Blaulichtbereich für 5VISION tätig.</p>
          <div class="lp-about__cta">
            <a href="/infos/ueber-mich" class="btn">Mehr über mich</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ─── Services ──────────────────────────────────────── -->
    <section class="section lp-services">
      <div class="container">
        <div class="lp-services__header reveal">
          <span class="section-label">Was ich anbiete</span>
          <h2 class="h-section lp-services__title">Drei Bereiche.<br/>Ein Anspruch.</h2>
        </div>
        <div class="lp-services__grid">
          <a href="/leistungen/autofotografie" class="lp-card lp-card--signal reveal reveal--delay-1">
            <div class="lp-card__no">01</div>
            <div class="lp-card__body">
              <h3 class="lp-card__title">Auto&shy;fotografie</h3>
              <p class="lp-card__desc">Static, Rolling & Verkaufsfotos —<br/>dein Fahrzeug in Szene gesetzt.</p>
              <span class="lp-card__link">
                Mehr erfahren
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="3" y1="8" x2="13" y2="8"/><polyline points="9,4 13,8 9,12"/>
                </svg>
              </span>
            </div>
            <div class="lp-card__accent"></div>
          </a>

          <a href="/leistungen/eventbegleitung" class="lp-card lp-card--signal reveal reveal--delay-2">
            <div class="lp-card__no">02</div>
            <div class="lp-card__body">
              <h3 class="lp-card__title">Event&shy;fotografie</h3>
              <p class="lp-card__desc">Veranstaltungen und Pressefotografie —<br/>im Reportagestil, nah dran aber unauffällig.</p>
              <span class="lp-card__link">
                Mehr erfahren
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="3" y1="8" x2="13" y2="8"/><polyline points="9,4 13,8 9,12"/>
                </svg>
              </span>
            </div>
            <div class="lp-card__accent"></div>
          </a>

          <a href="/kontakt" class="lp-card reveal reveal--delay-3">
            <div class="lp-card__no">03</div>
            <div class="lp-card__body">
              <h3 class="lp-card__title">Dein individuelles Projekt</h3>
              <p class="lp-card__desc">Individuelle Anfragen willkommen —<br/>schreib mir einfach deine Idee.</p>
              <span class="lp-card__link">
                Anfrage senden
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="3" y1="8" x2="13" y2="8"/><polyline points="9,4 13,8 9,12"/>
                </svg>
              </span>
            </div>
            <div class="lp-card__accent"></div>
          </a>
        </div>
        <div class="lp-services__cta reveal">
          <a href="/infos/preise" class="btn">Preise &amp; Pakete</a>
        </div>
      </div>
    </section>

    <!-- ─── Stats ─────────────────────────────────────────── -->
    <div class="lp-stats-wrap">
      <div class="container lp-stats">
        <div class="lp-stat reveal">
          <span class="lp-stat__num" data-count="50">0</span>
          <span class="lp-stat__plus">+</span>
          <span class="lp-stat__label">Fotoshootings</span>
        </div>
        <div class="lp-stat__divider" aria-hidden="true"></div>
        <div class="lp-stat reveal reveal--delay-1">
          <span class="lp-stat__num" data-count="4">0</span>
          <span class="lp-stat__plus">+</span>
          <span class="lp-stat__label">Jahre Erfahrung</span>
        </div>
      </div>
    </div>

    <!-- ─── Featured Work ─────────────────────────────────── -->
    <section class="section lp-work">
      <div class="container">
        <div class="lp-work__header reveal">
          <span class="section-label">Ausgewählte Arbeiten</span>
          <div class="lp-work__header-row">
            <h2 class="h-section">Einblick in<br/>meine Arbeit.</h2>
          </div>
        </div>

        <div class="lp-work__grid">
          {featured.map((s, i) => (
            <a
              href={`/galerie/${s.slug}`}
              class={`lp-work__item lp-work__item--${i} reveal reveal--delay-${(i % 3) + 1}`}
            >
              <div class="lp-work__img">
                <img src={s.cover} alt={`${s.fahrzeug} – NB Autofokus`} loading="lazy" decoding="async" width="900" height="600" />
                <div class="lp-work__overlay">
                  <span class="lp-work__overlay-label">{s.kategorie}</span>
                  <span class="lp-work__overlay-title">{s.fahrzeug}</span>
                  <span class="lp-work__overlay-cta">{s.gruppe === 'Autoshootings' ? 'Shooting ansehen →' : 'Bilder ansehen →'}</span>
                </div>
              </div>
            </a>
          ))}
        </div>
        <div class="lp-work__cta reveal">
          <a href="/galerie" class="btn">Komplette Galerie</a>
        </div>
      </div>
    </section>

    <!-- ─── Testimonials ──────────────────────────────────── -->
    <Testimonials />

    <!-- ─── CTA ───────────────────────────────────────────── -->
    <section class="lp-cta">
      <div class="lp-cta__bg" aria-hidden="true"></div>
      <div class="container lp-cta__inner reveal">
        <span class="section-label">Bereit?</span>
        <h2 class="lp-cta__title">Dein Shooting<br/>wartet.</h2>
        <p class="lp-cta__sub">Schick mir deine Idee — ich freue mich auf deine Anfrage.</p>
        <div class="lp-cta__actions">
          <a href="/kontakt" class="btn btn--primary lp-cta__btn">
            Anfrage senden
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="3" y1="8" x2="13" y2="8"/><polyline points="9,4 13,8 9,12"/>
            </svg>
          </a>
          <a href="https://instagram.com/nb_autofokus" class="btn lp-cta__ig" target="_blank" rel="noopener noreferrer">
            Instagram ansehen
          </a>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>

<script>
  const statNums = document.querySelectorAll<HTMLElement>('.lp-stat__num[data-count]');
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (!entry.isIntersecting) return;
      const el = entry.target as HTMLElement;
      const target = parseInt(el.dataset.count || '0', 10);
      const duration = 1200;
      const step = duration / target;
      let current = 0;
      const timer = setInterval(() => {
        current++;
        el.textContent = String(current);
        if (current >= target) clearInterval(timer);
      }, step);
      obs.unobserve(el);
    });
  }, { threshold: 0.5 });

  statNums.forEach(el => obs.observe(el));
</script>

<style>
/* ─── Services ──────────────────────────────────────── */
.lp-services { background: var(--color-coal); }

.lp-services__header { margin-bottom: var(--space-12); }

.lp-services__title { max-width: 16ch; }

.lp-services__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-4);
}

.lp-services__cta {
  margin-top: var(--space-8);
  text-align: center;
}

.lp-card {
  position: relative;
  background: var(--color-graphite);
  border: 1px solid var(--color-iron);
  padding: var(--space-8);
  display: flex;
  flex-direction: column;
  gap: var(--space-6);
  overflow: hidden;
  cursor: pointer;
  transition: border-color var(--transition-base), transform var(--transition-slow);
}

.lp-card:hover {
  border-color: var(--color-signal);
  transform: translateY(-3px);
}

.lp-card--signal {
  border-color: var(--color-signal);
  background: linear-gradient(135deg, var(--color-graphite) 0%, rgba(230,57,70,0.08) 100%);
}

.lp-card__accent {
  position: absolute;
  bottom: 0; left: 0;
  height: 2px;
  width: 0;
  background: var(--color-signal);
  transition: width 400ms ease;
}

.lp-card:hover .lp-card__accent,
.lp-card--signal .lp-card__accent { width: 100%; }

.lp-card__no {
  font-family: var(--font-display);
  font-size: 4rem;
  color: var(--color-iron);
  line-height: 1;
  letter-spacing: 0.04em;
  transition: color var(--transition-base);
}

.lp-card:hover .lp-card__no { color: var(--color-signal); }
.lp-card--signal .lp-card__no { color: var(--color-signal); }

.lp-card__title {
  font-family: var(--font-display);
  font-size: clamp(2rem, 3.5vw, 3rem);
  letter-spacing: 0.04em;
  color: var(--color-white);
  line-height: 0.95;
  margin-bottom: var(--space-4);
}

.lp-card__desc {
  font-size: var(--text-caption);
  color: var(--color-silver);
  line-height: 1.7;
  max-width: 34ch;
}

.lp-card__link {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  font-size: var(--text-label);
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--color-signal);
  margin-top: auto;
  transition: gap var(--transition-base);
}

.lp-card:hover .lp-card__link { gap: var(--space-3); }

/* ─── Stats ─────────────────────────────────────────── */
.lp-about__inner {
  max-width: 680px;
}

.lp-about__text h2 {
  margin-block: var(--space-3) var(--space-6);
}

.lp-about__lead {
  color: var(--color-muted);
  margin-bottom: var(--space-8);
  line-height: 1.7;
}

.lp-about__cta {
  text-align: center;
}

.lp-stats-wrap {
  background: var(--color-black);
  border-top: 1px solid var(--color-iron);
  border-bottom: 1px solid var(--color-iron);
}

.lp-stats {
  display: grid;
  grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;
  align-items: center;
  padding-block: var(--space-12);
  gap: 0;
}

.lp-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-2);
  text-align: center;
  padding: var(--space-6);
}

.lp-stat__num {
  font-family: var(--font-display);
  font-size: clamp(3.5rem, 6vw, 6rem);
  color: var(--color-white);
  line-height: 1;
  letter-spacing: 0.04em;
}

.lp-stat__plus {
  font-family: var(--font-display);
  font-size: clamp(1.5rem, 2.5vw, 2.5rem);
  color: var(--color-signal);
  line-height: 1;
  margin-left: 2px;
  align-self: flex-start;
  margin-top: 0.5rem;
}

.lp-stat > .lp-stat__num,
.lp-stat > .lp-stat__plus {
  display: inline;
}

.lp-stat {
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: center;
  align-items: flex-start;
}

.lp-stat__label {
  width: 100%;
  font-size: var(--text-label);
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--color-fog);
  text-align: center;
}

.lp-stat__divider {
  width: 1px;
  height: 60px;
  background: var(--color-iron);
}

/* ─── Featured Work ─────────────────────────────────── */
.lp-work { background: var(--color-coal); }

.lp-work__header { margin-bottom: var(--space-12); }

.lp-work__header-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: var(--space-6);
  margin-top: var(--space-4);
}

.lp-work__all { flex-shrink: 0; align-self: flex-end; margin-bottom: 4px; }

.lp-work__cta {
  margin-top: var(--space-8);
  text-align: center;
}

.lp-work__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-3);
}

.lp-work__item {
  position: relative;
  overflow: hidden;
  display: block;
  cursor: pointer;
}

.lp-work__img {
  position: relative;
  width: 100%;
  height: 100%;
  min-height: 320px;
}

.lp-work__img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 600ms cubic-bezier(0.2, 0.8, 0.2, 1);
}

.lp-work__item:hover .lp-work__img img { transform: scale(1.04); }

.lp-work__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0) 55%);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: var(--space-6);
  opacity: 0;
  transition: opacity var(--transition-base);
}

.lp-work__item:hover .lp-work__overlay { opacity: 1; }

.lp-work__overlay-label {
  font-size: var(--text-label);
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--color-signal);
  margin-bottom: var(--space-1);
}

.lp-work__overlay-title {
  font-family: var(--font-display);
  font-size: 1.6rem;
  letter-spacing: 0.06em;
  color: var(--color-white);
  line-height: 1.1;
  margin-bottom: var(--space-3);
}

.lp-work__overlay-cta {
  font-size: var(--text-caption);
  color: var(--color-silver);
}

/* ─── CTA ───────────────────────────────────────────── */
.lp-cta {
  position: relative;
  padding-block: clamp(5rem, 12vw, 10rem);
  overflow: hidden;
  background: var(--color-black);
  border-top: 1px solid var(--color-iron);
}

.lp-cta__bg {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse 80% 60% at 50% 100%, rgba(230,57,70,0.12) 0%, transparent 70%);
  pointer-events: none;
}

.lp-cta__inner {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: var(--space-6);
}

.lp-cta__title {
  font-family: var(--font-display);
  font-size: clamp(4rem, 10vw, 9rem);
  letter-spacing: 0.03em;
  color: var(--color-white);
  line-height: 0.9;
}

.lp-cta__sub {
  color: var(--color-silver);
  max-width: 44ch;
}

.lp-cta__actions {
  display: flex;
  gap: var(--space-4);
  flex-wrap: wrap;
  justify-content: center;
  margin-top: var(--space-4);
}

.lp-cta__btn { min-width: 200px; justify-content: center; }

.lp-cta__ig { color: var(--color-silver); }

/* ─── Reduced motion ────────────────────────────────── */
@media (prefers-reduced-motion: reduce) {
  .lp-work__img img { transition: none; }
  .lp-card { transition: none; }
}

/* ─── Responsive ────────────────────────────────────── */
@media (max-width: 900px) {
  .lp-services__grid { grid-template-columns: 1fr; }

  .lp-stats {
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto auto;
  }
  .lp-stat__divider { display: none; }

  .lp-work__grid {
    grid-template-columns: 1fr;
    grid-template-rows: auto;
  }
  .lp-work__item--0 { grid-row: auto; }
  .lp-work__item--2,
  .lp-work__item--3 { grid-column: auto; }

  .lp-work__img,
  .lp-work__item--0 .lp-work__img {
    min-height: unset;
    aspect-ratio: 4 / 3;
  }

  .lp-work__header-row { flex-direction: column; align-items: flex-start; }
  .lp-work__overlay { opacity: 1; }
}

@media (max-width: 600px) {
  .lp-stats { grid-template-columns: 1fr 1fr; }
  .lp-cta__actions { flex-direction: column; align-items: center; }
}
</style>
