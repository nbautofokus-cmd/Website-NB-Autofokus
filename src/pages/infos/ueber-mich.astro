---
import { Image } from 'astro:assets';
import portrait from '../../assets/images/about/portrait.jpg';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import PageHeader from '../../components/PageHeader.astro';
import Footer from '../../components/Footer.astro';
---
<BaseLayout
  title="Über mich | NB Autofokus"
  description="Nicolai Biehl — Autofotograf und Eventfotograf im Rhein-Main-Gebiet. Erfahre mehr über meine Arbeit, meinen Stil und meine Erfahrung."
>
  <Nav />
  <main id="main">
    <PageHeader
      label="Infos"
      title="Über mich."
    />

    <section class="section">
      <div class="container about-grid">

        <div class="about-portrait reveal">
          <Image
            src={portrait}
            alt="Nicolai — NB Autofokus"
            width={900}
            height={1200}
            loading="eager"
            format="webp"
            quality={85}
          />
          <div class="about-portrait__tag">
            <span class="about-portrait__tag-no">N.B.</span>
            <span class="about-portrait__tag-label">Autofokus</span>
          </div>
        </div>

        <div class="about-content">
          <div class="reveal">
            <span class="section-label">Dein Fotograf</span>
            <h2 class="about-content__title h-section">Nicolai Biehl.</h2>
          </div>

          <p class="about-content__lead reveal reveal--delay-1">
            Ich heiße Nicolai und bin Fotograf im Rhein-Main-Gebiet — von Frankfurt, Offenbach
            und Hanau über Rodgau bis nach Aschaffenburg und Darmstadt. Neben privaten Shootings bin ich
            regelmäßig für die Firma Kickdown als Autofotograf im Einsatz — dort entstehen detailreiche
            Fotoreihen mit bis zu 150 Bildern, oft rund um Oldtimer und klassische Fahrzeuge. Außerdem
            bin ich als Pressefotograf im Blaulichtbereich im Auftrag von 5VISION tätig.
            Ich begleite regelmäßig Einsätze der Polizei und Feuerwehr und liefere Bilder von
            Einsatzlagen für diverse Redaktionen und Medienhäuser.
          </p>

          <p class="about-content__text reveal reveal--delay-1">
            Schick mir gerne eine Anfrage, wenn du aussagekräftige Bilder brauchst, oder Interesse
            an einer fotografischen Begleitung deines Events hast.
          </p>

          <div class="about-stats reveal reveal--delay-2">
            <div class="about-stat">
              <span class="about-stat__num">50+</span>
              <span class="about-stat__label">Fotoshootings</span>
            </div>
            <div class="about-stat">
              <span class="about-stat__num">4+</span>
              <span class="about-stat__label">Jahre als Fotograf</span>
            </div>
          </div>

          <div class="about-cta reveal reveal--delay-2">
            <a href="/kontakt" class="btn btn--primary">
              Anfrage stellen
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="3" y1="8" x2="13" y2="8"/>
                <polyline points="9,4 13,8 9,12"/>
              </svg>
            </a>
            <a href="https://instagram.com/nb_autofokus" class="btn" target="_blank" rel="noopener noreferrer">
              Instagram
            </a>
          </div>
        </div>

      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
.about-grid {
  display: grid;
  grid-template-columns: minmax(280px, 1fr) 1.2fr;
  gap: clamp(2rem, 6vw, 6rem);
  align-items: start;
}

.about-portrait {
  position: relative;
  aspect-ratio: 3 / 4;
  overflow: hidden;
  background: var(--color-graphite);
}

.about-portrait img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: contrast(1.05) saturate(0.95);
}

.about-portrait__tag {
  position: absolute;
  bottom: var(--space-6);
  left: var(--space-6);
  display: flex;
  flex-direction: column;
  padding: var(--space-3) var(--space-4);
  background: rgba(10, 10, 10, 0.75);
  backdrop-filter: blur(10px);
  border-left: 2px solid var(--color-signal);
}

.about-portrait__tag-no {
  font-family: var(--font-display);
  font-size: 1.4rem;
  letter-spacing: 0.08em;
  color: var(--color-white);
  line-height: 1;
}

.about-portrait__tag-label {
  font-size: var(--text-label);
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--color-silver);
  margin-top: 4px;
}

.about-content__title { margin-bottom: var(--space-6); }

.about-content__lead {
  font-size: 1.1rem;
  color: var(--color-bone);
  line-height: 1.65;
  margin-bottom: var(--space-4);
  max-width: 56ch;
}

.about-content__text {
  color: var(--color-silver);
  margin-bottom: var(--space-8);
  max-width: 56ch;
}

.about-stats {
  display: flex;
  gap: clamp(1.5rem, 4vw, 3rem);
  padding-block: var(--space-6);
  border-top: 1px solid var(--color-iron);
  border-bottom: 1px solid var(--color-iron);
  margin-bottom: var(--space-8);
}

.about-stat { display: flex; flex-direction: column; gap: var(--space-1); }

.about-stat__num {
  font-family: var(--font-display);
  font-size: clamp(2rem, 4vw, 2.8rem);
  color: var(--color-white);
  letter-spacing: 0.04em;
  line-height: 1;
}

.about-stat__label {
  font-size: var(--text-label);
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--color-fog);
}

.about-cta { display: flex; gap: var(--space-4); flex-wrap: wrap; }

@media (max-width: 800px) {
  .about-grid { grid-template-columns: 1fr; }
}
</style>
