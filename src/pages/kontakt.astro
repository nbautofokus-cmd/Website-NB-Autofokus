---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout
  title="Kontakt | NB Autofokus"
  description="Anfrage stellen für Autofotografie, Eventbegleitung oder Pressefotografie im Rhein-Main-Gebiet."
>
  <Nav />
  <main id="main" style="padding-top: calc(80px + var(--space-8));">
    <Contact />
  </main>
  <Footer />
</BaseLayout>
