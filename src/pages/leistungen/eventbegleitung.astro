---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import PageHeader from '../../components/PageHeader.astro';
import Footer from '../../components/Footer.astro';
import { shootings } from '../../data/shootings';
import '../../styles/gallery.css';

const eventshootings = shootings.filter(s => ['event-4', 'blaulicht-1'].includes(s.slug));
---
<BaseLayout
  title="Eventfotografie | NB Autofokus"
  description="Eventfotografie und Reportagebegleitung im Rhein-Main-Gebiet. Automotive Events, Firmenveranstaltungen und Presse — authentisch dokumentiert, schnell ausgeliefert."
>
  <Nav />
  <main id="main">
    <PageHeader
      label="Leistungen"
      title="Event&shy;fotografie."
      sub="Automotive Events, Firmenveranstaltungen, Presse- und Eventbegleitung — authentisch dokumentiert, schnell ausgeliefert."
      image="/images/shootings/event-4/cover.jpg"
    />

    <section class="section">
      <div class="container">
        <div class="event-intro reveal">
          <div class="event-intro__text">
            <span class="section-label">Was ich mache</span>
            <h2 class="h-section">Dein Event.<br/>Festgehalten.</h2>
            <p>
              Ich fotografiere Automotive Events, Veranstaltungen und begleite
              Einsätze im Presse- und Blaulichtbereich. Im Reportagestil, nah dran aber unauffällig.
            </p>
            <p>
              Mit über 50 begleiteten Veranstaltungen — von Hochzeiten bis hin zu
              Firmenfeiern — weiß ich, worauf es ankommt.
            </p>
            <p>
              Die fertigen Bilder erhältst du zeitnah nach dem Event — nutzbar für
              Social Media, Pressemitteilungen oder dein Archiv.
            </p>
          </div>

          <article class="event-price-card reveal reveal--delay-1">
            <span class="event-price-card__id">Eventfotografie</span>
            <div class="event-price-card__price">
              <span class="event-price-card__prefix">ab</span>
              <span class="event-price-card__amount">100</span>
              <span class="event-price-card__currency">€</span>
            </div>
            <p class="event-price-card__desc">Preis abhängig von Dauer & Umfang.</p>
            <ul class="event-price-card__list">
              {[
                'Authentischer Reportagestil',
                'Schnelle Lieferung nach oder während dem Event',
                'Anfahrt (Rodgau + 50 km) inklusive',
              ].map((item) => (
                <li>
                  <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="3,8 7,12 13,4"/>
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
            <a href="/kontakt" class="btn btn--primary event-price-card__cta">
              Event anfragen
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="3" y1="8" x2="13" y2="8"/>
                <polyline points="9,4 13,8 9,12"/>
              </svg>
            </a>
          </article>
        </div>
      </div>
    </section>

    <section class="section section--coal">
      <div class="container">
        <header class="section-header reveal">
          <span class="section-label">Was dich erwartet</span>
          <h2 class="h-section">Der Ablauf.</h2>
        </header>
        <div class="steps">
          {[
            { step: '01', title: 'Anfrage',     desc: 'Du schickst mir Datum, Location und den ungefähren Umfang deines Events.' },
            { step: '02', title: 'Besprechung',   desc: 'Wir klären Details, Wünsche und den finalen Preis.' },
            { step: '03', title: 'Event',       desc: 'Ich bin dabei - im Reportagestil, unauffällig und nah dran.' },
            { step: '04', title: 'Lieferung',   desc: 'Du erhältst die bearbeiteten Bilder zeitnah nach oder während dem Event.'},
          ].map((s, i) => (
            <div class={`step reveal reveal--delay-${i + 1}`}>
              <span class="step__no">{s.step}</span>
              <div>
                <h3 class="step__title">{s.title}</h3>
                <p class="step__desc">{s.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <header class="gallery__header">
          <span class="section-label reveal">Galerie</span>
          <h2 class="h-section reveal">Eindrücke<br/>meiner Arbeit.</h2>
        </header>
        <div class="gallery__grid">
          {eventshootings.map((s, i) => (
            <a href={`/galerie/${s.slug}`} class={`gallery__tile reveal reveal--delay-${(i % 3) + 1}`}>
              <div class="gallery__tile-img">
                <img src={s.cover} alt={`${s.fahrzeug} – Eventfotografie NB Autofokus`} loading="lazy" decoding="async" width="800" height="600" />
                <div class="gallery__tile-overlay">
                  <span class="gallery__tile-cta">Bilder ansehen →</span>
                </div>
              </div>
              <div class="gallery__tile-info">
                <span class="gallery__tile-kategorie">{s.kategorie}</span>
                <span class="gallery__tile-fahrzeug">{s.fahrzeug}</span>
                <span class="gallery__tile-datum">{s.datum}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container cta-center reveal">
        <a href="/kontakt" class="btn btn--primary">
          Jetzt anfragen
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="3" y1="8" x2="13" y2="8"/>
            <polyline points="9,4 13,8 9,12"/>
          </svg>
        </a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
.event-intro {
  display: grid;
  grid-template-columns: 1fr 380px;
  gap: var(--space-16);
  align-items: start;
}

.event-intro__text p { color: var(--color-silver); line-height: 1.7; margin-bottom: var(--space-4); }

.event-price-card {
  background: var(--color-graphite);
  border: 1px solid var(--color-iron);
  padding: var(--space-8);
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
  position: sticky;
  top: 90px;
}

.event-price-card__id {
  font-family: var(--font-display);
  font-size: 2.2rem;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--color-signal);
  line-height: 1;
}

.event-price-card__price {
  display: flex;
  align-items: baseline;
  gap: var(--space-1);
}

.event-price-card__prefix { font-size: 1.2rem; color: var(--color-silver); }
.event-price-card__amount { font-family: var(--font-display); font-size: 2.8rem; color: var(--color-white); line-height: 1; }
.event-price-card__currency { font-size: 1.4rem; color: var(--color-silver); }

.event-price-card__desc {
  font-size: var(--text-caption);
  color: var(--color-fog);
}

.event-price-card__list { display: flex; flex-direction: column; gap: var(--space-2); }
.event-price-card__list li {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  font-size: var(--text-caption);
  color: var(--color-silver);
}
.event-price-card__list svg { color: var(--color-signal); flex-shrink: 0; }
.event-price-card__cta { margin-top: var(--space-2); justify-content: center; }

/* Steps */
.section-header { margin-bottom: var(--space-12); }

.steps {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--space-4);
}

.step {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
  padding: var(--space-8);
  border: 1px solid var(--color-iron);
  background: var(--color-graphite);
}

.step__no {
  font-family: var(--font-display);
  font-size: 2rem;
  color: var(--color-signal);
  line-height: 1;
}

.step__title {
  font-family: var(--font-display);
  font-size: 1.4rem;
  letter-spacing: 0.04em;
  color: var(--color-white);
  margin-bottom: var(--space-2);
}

.step__desc { font-size: var(--text-caption); color: var(--color-silver); line-height: 1.6; }

.cta-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-8);
  text-align: center;
}

.gallery__grid { grid-template-columns: repeat(2, 1fr); }

@media (max-width: 900px) {
  .event-intro { grid-template-columns: 1fr; }
  .event-price-card { position: static; }
  .steps { grid-template-columns: 1fr 1fr; }
  .gallery__grid { grid-template-columns: 1fr; }
}

@media (max-width: 600px) {
  .steps { grid-template-columns: 1fr; }
  .cta-band { flex-direction: column; align-items: flex-start; }
}
</style>
